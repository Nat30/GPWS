# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# LVGL 分配器：默认改用系统堆的标准 malloc/realloc/free。
# 内置 24KB 静态池在复杂圆角/蒙版绘制时会耗尽，lv_malloc 返回 NULL 后 LVGL 断言死循环，
# 饿死 IDLE 触发 TWDT 冻屏（真机已复现：圆角蒙版表分配失败）。系统堆约 130KB 可用，
# 不会占用额外静态区；仍可按需改回内置池并调 CONFIG_LV_MEM_SIZE_KILOBYTES。
CONFIG_LV_USE_CLIB_MALLOC=y

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000
# app_main 任务栈:默认 3584 不够——app_boot_play 在 main 任务里
# lv_refr_now 同步渲染全屏首帧(icon_draw_event_cb 矢量绘制链)会溢出
# (真机 Stack protection fault,SP 低于下界 16 字节)。8192 留足余量。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# 深睡唤醒跳过 bootloader 镜像 CRC 校验:3.96MB 镜像逐字节校验耗时 1-2s
# (bootloader 阶段 flash 跑 DIO 低速)。深睡期间 flash 不断电,镜像不会损坏;
# 冷上电/软复位路径照常全量校验。唤醒 3s → ~1s 的主要来源就是这项。
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y

# --- 电源管理 DFS 降频 ---
# 自动 DFS:CPU 空闲时降频 160→40MHz,唤醒事件前自动回满频。APB 恒 80MHz,
# LEDC 背光/ADC 按键/I2S(时钟源独立)/esp_timer 均不受影响;播放期 CPU 多在
# DMA 等待,收益集中在长闲置与聆听熄屏场景。不用 light sleep:三键经 ADC
# 分压共用 GPIO0,light sleep 下该脚无数字电平唤醒能力。
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_DFS_INIT_AUTO=y

# --- ADC 按键采样平均 ---
# 三键经分压共用 GPIO0 的 ADC。SAMPLE_TIMES=1 时单次读数直接判窗,音频播放
# (功放纹波)期间 ADC 噪声可跨 DOWN/OK 窗口边界(447mV, bsp_pins.h),真机
# 表现为 quiz 答题页(唯一"播放中按键"的页面)下键/确认键判读互换。
# 组件上限 4 次/轮询(1..4, Kconfig),配合 5ms 轮询 × 40ms 确认窗 = 32 样本。
CONFIG_ADC_BUTTON_SAMPLE_TIMES=4

# --- Bluetooth LE / NimBLE ---
# ESP32-C3 仅支持 BLE；示例只启用单连接 peripheral 所需的最小 host 配置。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n
